{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovibe-gym.local/schemas/paper_v2_confirmatory_dataset_scope.schema.json",
  "title": "AutoVibe Gym Paper V2 Confirmatory Dataset Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "confirmatory_outcomes_visible",
    "datasets",
    "independent_review_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "paper-v2-confirmatory-dataset-scope-v1"
    },
    "manifest_id": { "$ref": "#/$defs/identifier" },
    "confirmatory_outcomes_visible": { "const": false },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "independent_review_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_identity_hash",
        "dataset_content_hash",
        "source_lineage_hash",
        "dataset_card_hash"
      ],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/identifier" },
        "dataset_identity_hash": { "$ref": "#/$defs/sha256" },
        "dataset_content_hash": { "$ref": "#/$defs/sha256" },
        "source_lineage_hash": { "$ref": "#/$defs/sha256" },
        "dataset_card_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
